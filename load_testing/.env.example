# Copy to load_testing/.env and fill in values.
# NEVER commit .env to source control — it contains secrets.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   ./run_all.sh

# ── Required ─────────────────────────────────────────────────────────────────
# Credentials for the single pre-seeded test user account.
GYD_TEST_USERNAME=admin@example.com
GYD_TEST_PASSWORD=change_me_before_testing

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# Base URL of the service under test. Trailing slash is stripped automatically.
# On macOS/Windows Docker Desktop use http://host.docker.internal:8080 to
# reach a service running on the host.
GYD_TARGET_URL=http://localhost:8080

# Label recorded in _context.json — helps correlate results across platforms.
# Examples: local, railway-prod, azure-eastus, aws-us-east-1
GYD_PLATFORM_NAME=local

# Database type label in _context.json. Values: sqlite or postgres
GYD_DB_TYPE=sqlite

# ── Load profile tuning ───────────────────────────────────────────────────────
# Per-endpoint RPS targets. Group user counts are derived from these values.
# Group 4 logout/meta have separate targets (token pool and namespace constraints).
GYD_RPS_MODERATE=100
GYD_RPS_STRESS=500

# Shape timing (seconds).
GYD_RAMP_TIME=60
GYD_MODERATE_DURATION=120
GYD_STRESS_HOLD=90

# Group 4: logout and meta endpoint targets (token pool and namespace constrained).
# lower targets as logout and meta updates have less real demand
GYD_LOGOUT_RPS_MODERATE=10
GYD_LOGOUT_RPS_STRESS=40
GYD_META_RPS_MODERATE=5
GYD_META_RPS_STRESS=20

# Phase to run. Values: moderate or stress
# Has no effect when using run_all.sh or run_group.sh — those scripts set this
# automatically. Only relevant when invoking Locust directly without the runner scripts.
GYD_PHASE=moderate

# Directory (inside the container) where all output files are written.
# Maps to load_testing/results/ on the host via the Docker volume mount.
GYD_RESULTS_DIR=results
