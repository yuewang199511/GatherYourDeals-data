# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is intentionally gitignored — never commit real secrets.

# JWT signing secret. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
GYD_JWT_SECRET=replace-this-with-a-random-32-plus-char-secret

# Database driver. Overrides database.driver in config.yaml.
# Valid values: sqlite (default), postgres
# GYD_DATABASE_DRIVER=postgres

# PostgreSQL connection string. Overrides database.path in config.yaml.
# Accepts URI format:
#   postgres://user:password@host:5432/dbname?sslmode=require
# Accepts key-value DSN format:
#   host=myserver.postgres.database.azure.com port=5432 dbname=mydb user=mylogin password=secret sslmode=require
# Railway auto-injects DATABASE_URL when a PostgreSQL add-on is provisioned.
# DATABASE_URL=

# ── OpenTelemetry / Honeycomb (optional) ─────────────────────────────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT blank to disable all OTel export.
# When set, traces and logs are exported via OTLP/HTTP to the endpoint below.
#
# Honeycomb:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
#   OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<your-ingest-key>
#   OTEL_SERVICE_NAME=gatheryourdeals
#
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gatheryourdeals
# Deployment context — comma-separated key=value pairs, auto-read by the OTel SDK.
# service.environment distinguishes production/staging/local in Honeycomb queries.
# platform.name and db.type appear on every span for cross-deployment filtering.
OTEL_RESOURCE_ATTRIBUTES=service.environment=local,platform.name=local,db.type=sqlite
